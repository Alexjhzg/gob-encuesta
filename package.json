{
  "name": "kobo-geo-dashboard",
  "version": "1.0.0",
  "description": "Plataforma de Inteligencia Territorial y Visualización Geográfica para Encuestas de Campo KoboToolbox con React, Leaflet y FastAPI/Express Backend.",
  "author": "Alexjhzg",
  "license": "MIT",
  "keywords": [
    "kobotoolbox",
    "geojson",
    "leaflet",
    "react",
    "gis",
    "fastapi",
    "dashboard",
    "data-visualization",
    "surveys"
  ],
  "private": false,
  "type": "module",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "./venv/bin/python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8005 --reload",
    "test:python": "PYTHONPATH=. ./venv/bin/pytest tests_python",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
